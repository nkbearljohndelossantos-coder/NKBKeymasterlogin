PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=nkb_auth_db

# Security & Secret Management
JWT_SECRET=CHANGE_ME_JWT_SECRET
MAX_FAILED_LOGINS=5
LOCKOUT_DURATION_MINUTES=15

# AD Identity Service Inter-Service Authentication
AD_SERVICE_HOST=127.0.0.1
AD_SERVICE_PORT=3001
AUTH_API_AD_SERVICE_TOKEN=CHANGE_ME_AD_SERVICE_TOKEN
