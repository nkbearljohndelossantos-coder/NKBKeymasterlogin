PORT=3001
NODE_ENV=development

# Active Directory Provider: 'active-directory' (production) or 'mock' (test/development)
AD_PROVIDER=active-directory

# Service Authentication Secret (must match AUTH_API_AD_SERVICE_TOKEN)
AD_SERVICE_EXPECTED_TOKEN=CHANGE_ME_AD_SERVICE_TOKEN

# Active Directory Domain Controller Configuration
AD_DOMAIN=NKB.LOCAL
AD_SERVICE_ACCOUNT=svc-nkb-auth
AD_SERVICE_PASSWORD=CHANGE_ME_AD_SERVICE_PASSWORD
LDAPS_URI=ldaps://dc01.nkb.local:636
AD_BASE_DN=DC=NKB,DC=LOCAL
AD_TLS_REJECT_UNAUTHORIZED=true
