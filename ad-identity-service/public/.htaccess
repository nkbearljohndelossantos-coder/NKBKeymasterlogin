# Hostinger Clean URL Rewrite for NKB Authentication API
RewriteEngine On
RewriteBase /

# Route /health to index.php
RewriteRule ^health$ index.php [L,QSA]

# Route /api/v1/auth/verify to api/v1/auth/verify.php
RewriteRule ^api/v1/auth/verify/?$ api/v1/auth/verify.php [L,QSA]
RewriteRule ^api/v1/auth/verify.php$ - [L]

# Prevent directory listings
Options -Indexes
